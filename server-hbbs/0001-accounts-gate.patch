+    /// Asks rd-api whether `token` may open `target_id`. Returns the refusal text when the
+    /// connection must be refused: in enforce mode on deny or error, in audit mode only on a deny
+    /// for a target rd-api marks as enforced; otherwise the decision is only logged.
+    async fn check_access(
+        &self,
+        token: &str,
+        target_id: &str,
+        addr: SocketAddr,
+        ws: bool,
+        kind: &'static str,
+    ) -> Option<String> {
+        let auth = &self.inner.auth;
+        if auth.mode == AuthMode::Off {
+            return None;
+        }
+        let ip = try_into_v4(addr).ip().to_string();
+        let body = serde_json::json!({
+            "token": token,
+            "target_id": target_id,
+            "kind": kind,
+            "ip": ip,
+            "ws": ws,
+            "mode": auth.mode_name(),
+        })
+        .to_string();
+        let url = format!("{}/internal/authorize", auth.url);
+        let secret = auth.secret.clone();
+        let res = match tokio::task::spawn_blocking(move || internal_post(url, secret, body)).await {
+            Ok(r) => r,
+            Err(e) => Err(e.to_string()),
+        }
+        .and_then(|bytes| {
+            serde_json::from_slice::<serde_json::Value>(&bytes).map_err(|e| e.to_string())
+        });
+        match res {
+            Ok(v) => {
+                let allow = v.get("allow").and_then(|x| x.as_bool()).unwrap_or(false);
+                let enforced = v.get("enforce").and_then(|x| x.as_bool()).unwrap_or(false);
+                let reason = v.get("reason").and_then(|x| x.as_str()).unwrap_or("");
+                let user = v.get("user").and_then(|x| x.as_str()).unwrap_or("");
+                let deny = !allow && (auth.mode == AuthMode::Enforce || enforced);
+                log::info!(
+                    "access {} to {} from {} user={:?} reason={} result={}",
+                    kind,
+                    target_id,
+                    ip,
+                    user,
+                    reason,
+                    if allow {
+                        "allow"
+                    } else if deny {
+                        "deny"
+                    } else {
+                        "would_deny"
+                    }
+                );
+                if !deny {
+                    None
+                } else if reason == "not_logged_in" || reason == "invalid_token" {
+                    Some(REFUSE_LOGIN.to_owned())
+                } else {
+                    Some(REFUSE_ACCESS.to_owned())
+                }
+            }
+            Err(err) => {
+                log::error!("access check {} to {} from {} failed: {}", kind, target_id, ip, err);
+                if auth.mode == AuthMode::Enforce {
+                    Some(REFUSE_UNREACHABLE.to_owned())
+                } else {
+                    None
+                }
+            }
+        }
+    }
