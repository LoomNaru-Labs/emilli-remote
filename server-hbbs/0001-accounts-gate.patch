+// ---- Emilli accounts gate (RUSTDESK-ACCOUNTS-BUILD, 2026-10-15) ----
+// Server half of the original (version 0) key exchange that logged-in 1.5.0 clients require,
+// and the per-connection access check against rd-api. The key exchange follows upstream PR
+// rustdesk/rustdesk-server#400 (AGPL-3.0); this file stays AGPL-3.0.
+
+/// Our signed X25519 box key, sent as the first frame of every TCP connection on the main port.
+struct KeyExchangeState {
+    box_sk: box_::SecretKey,
+    hello: Vec<u8>,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum AuthMode {
+    Off,
+    Audit,
+    Enforce,
+}
+
+#[derive(Clone)]
+struct AuthConfig {
+    mode: AuthMode,
+    url: String,
+    secret: String,
+}
+
+const REFUSE_LOGIN: &str = "Please log in to Emilli Remote first (로그인이 필요합니다)";
+const REFUSE_ACCESS: &str = "This account cannot access this device (이 기기에 접근 권한이 없습니다)";
+const REFUSE_UNREACHABLE: &str = "Login server unreachable, try again (로그인 서버 연결 실패)";
+const INTERNAL_TIMEOUT_SECS: u64 = 2;
+
+impl AuthConfig {
+    fn from_env() -> Self {
+        let url = std::env::var("RD_API_INTERNAL_URL")
+            .unwrap_or_default()
+            .trim()
+            .trim_end_matches('/')
+            .to_owned();
+        let secret = std::env::var("RD_INTERNAL_SECRET")
+            .unwrap_or_default()
+            .trim()
+            .to_owned();
+        let mut mode = match std::env::var("RD_AUTH_MODE")
+            .unwrap_or_default()
+            .trim()
+            .to_lowercase()
+            .as_str()
+        {
+            "off" => AuthMode::Off,
+            "enforce" => AuthMode::Enforce,
+            _ => AuthMode::Audit,
+        };
+        if url.is_empty() && mode == AuthMode::Audit {
+            log::warn!("RD_API_INTERNAL_URL is not set, access checks are off");
+            mode = AuthMode::Off;
+        }
+        if mode != AuthMode::Off && secret.is_empty() {
+            log::warn!("RD_INTERNAL_SECRET is not set");
+        }
+        log::info!("access checks: mode={:?} api={}", mode, url);
+        Self { mode, url, secret }
+    }
+
+    fn mode_name(&self) -> &'static str {
+        match self.mode {
+            AuthMode::Off => "off",
+            AuthMode::Audit => "audit",
+            AuthMode::Enforce => "enforce",
+        }
+    }
+}
+
+fn make_key_exchange(sk: &Option<sign::SecretKey>) -> Option<Arc<KeyExchangeState>> {
+    let sk = sk.as_ref()?;
+    // A set top bit tells 1.5.0 clients to expect signed parameters (version 1); keep it clear.
+    let (pk, box_sk) = loop {
+        let (pk, box_sk) = box_::gen_keypair();
+        if pk.0[31] & 0x80 == 0 {
+            break (pk, box_sk);
+        }
+    };
+    let mut msg = RendezvousMessage::new();
+    msg.set_key_exchange(KeyExchange {
+        keys: vec![sign::sign(&pk.0, sk).into()],
+        ..Default::default()
+    });
+    let hello = msg.write_to_bytes().ok()?;
+    log::info!("key exchange: on");
+    Some(Arc::new(KeyExchangeState { box_sk, hello }))
+}
+
+/// Opens the client's sealed symmetric key. Errors (never panics) on anything malformed.
+fn open_key_exchange(ex: &KeyExchange, kx: &KeyExchangeState) -> ResultType<secretbox::Key> {
+    if ex.keys.len() != 2 {
+        bail!("expected 2 keys, got {}", ex.keys.len());
+    }
+    Encrypt::decode(&ex.keys[1], &ex.keys[0], &kx.box_sk)
+}
+
+fn internal_post(url: String, secret: String, body: String) -> Result<Vec<u8>, String> {
+    let resp = minreq::post(url)
+        .with_header("Content-Type", "application/json")
+        .with_header("X-Internal-Secret", secret)
+        .with_body(body)
+        .with_timeout(INTERNAL_TIMEOUT_SECS)
+        .send()
+        .map_err(|e| e.to_string())?;
+    if resp.status_code != 200 {
+        return Err(format!("status {}", resp.status_code));
+    }
+    Ok(resp.into_bytes())
 }
 
